---
import Layout from '../layouts/Layout.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { site } from '../data/site.js';
import { articles } from '../data/articles.js';

const { slug, title, description, eyebrow } = Astro.props;
const others = articles.filter((a) => a.slug !== slug).slice(0, 3);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  author: { '@type': 'Organization', name: site.name, url: site.url },
  publisher: { '@type': 'Organization', name: site.name },
};
---
<Layout title={`${title} | Upkeep Property Maintenance`} description={description} schema={schema}>
  <section class="page-hero">
    <div class="wrap" style="max-width: 820px;">
      <span class="eyebrow">{eyebrow}</span>
      <h1>{title}</h1>
    </div>
  </section>
  <section style="padding-top: 0;">
    <article class="wrap article-body" style="max-width: 820px;">
      <slot />
    </article>
  </section>
  <section class="band" style="padding: 48px 0;">
    <div class="wrap">
      <h2 style="font-size: 1.4rem;">Keep reading</h2>
      <div class="grid grid-3">
        {others.map((a) => (
          <a class="card" href={`/articles/${a.slug}/`}>
            <h3 style="font-size: 1.05rem;">{a.title}</h3>
            <span class="more">Read →</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <CtaPanel />
</Layout>
