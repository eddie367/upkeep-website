---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Page Not Found | Upkeep Property Maintenance"
  description="That page could not be found."
>
  <section class="page-hero" style="padding-bottom: 96px;">
    <div class="wrap" style="text-align: center; max-width: 620px;">
      <span class="eyebrow">404</span>
      <h1>That page needs maintenance.</h1>
      <p class="lede">The page you were looking for is not here. The rest of the site is in good repair.</p>
      <div class="hero-ctas" style="justify-content: center;">
        <a href="/" class="btn btn-primary">Back to Home</a>
        <a href="/work-order/" class="btn btn-ghost">Request Service</a>
      </div>
    </div>
  </section>
</Layout>
