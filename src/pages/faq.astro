---
import Layout from '../layouts/Layout.astro';
import CtaPanel from '../components/CtaPanel.astro';
import { faqs } from '../data/faqs.js';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  title="Property Maintenance FAQ | Upkeep Property Maintenance"
  description="Answers about our service area, trades covered, response times, flat-rate pricing, and turnover packages in Middle Tennessee."
  schema={schema}
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">FAQ</span>
      <h1>Questions owners actually ask.</h1>
    </div>
  </section>
  <section style="padding-top: 0;">
    <div class="wrap" style="max-width: 820px;">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary><h3>{f.q}</h3><span class="faq-toggle" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>
  <CtaPanel heading="Still have a question?" body="Call us or request service with the details. A real person answers." />
</Layout>
