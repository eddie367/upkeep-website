---
import Layout from '../layouts/Layout.astro';
import CtaPanel from '../components/CtaPanel.astro';
import StatsBand from '../components/StatsBand.astro';
---
<Layout
  title="Maintenance for Property Managers & Landlords in Middle Tennessee | Upkeep"
  description="One maintenance vendor for your whole portfolio. Work orders, unit turnovers, and photo documentation for property managers and landlords across Nashville and Middle Tennessee."
>
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">For Property Managers & Landlords</span>
      <h1>One vendor. Your whole portfolio.</h1>
      <p class="lede">
        Upkeep was built around professional property management. We maintain
        more than 350 units across Middle Tennessee, and the model is simple:
        every trade under one roof, every job documented, every invoice
        flat-rate.
      </p>
    </div>
  </section>

  <StatsBand />

  <section>
    <div class="wrap">
      <h2>What working with Upkeep looks like</h2>
      <div class="grid grid-3">
        <div class="card">
          <h3>Work orders in, updates out</h3>
          <p>Submit work orders online with photos. We confirm within two business hours and keep you posted through completion, so you can answer owners without chasing anyone.</p>
        </div>
        <div class="card">
          <h3>Tenant coordination handled</h3>
          <p>Authorize tenant contact on the work order and we schedule access directly, in line with your notice requirements. One less phone chain for your team.</p>
        </div>
        <div class="card">
          <h3>Documentation owners trust</h3>
          <p>Photo reports, itemized flat-rate invoices, and move-in inspections on turnovers. A clean paper trail for every unit, every job.</p>
        </div>
        <div class="card">
          <h3>Turnovers on a clock</h3>
          <p>Three make-ready packages with known pricing and coordinated trades, so the vacancy math stays predictable.</p>
        </div>
        <div class="card">
          <h3>Capacity that scales with you</h3>
          <p>Take on new doors and your maintenance capacity is already there. No hiring, no trucks, no coverage gaps.</p>
        </div>
        <div class="card">
          <h3>Priced for portfolios</h3>
          <p>Flat rates quoted before work begins. No surprise invoices for you to explain to an owner.</p>
        </div>
      </div>
    </div>
  </section>

  <CtaPanel
    heading="Managing units in Middle Tennessee?"
    body="Call us and we will walk your properties, set response expectations, and take the maintenance calendar off your plate."
  />
</Layout>
